{
  "schemaVersion": 1,
  "id": "voicechat",
  "version": "${version}",
  "name": "Laby Voice Chat",
  "description": "LabyMod-compatible proximity voice chat with push-to-talk and volume controls for Minecraft 26.2.",
  "authors": [],
  "contact": {},
  "license": "AGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "pingplus.voicechat.client.VoicechatDataGenerator"
    ],
    "client": [
      "pingplus.voicechat.client.VoicechatClient",
      "com.coflnet.CoflModClient"
    ],
    "main": [
      "pingplus.voicechat.Voicechat",
      "com.coflnet.CoflMod"
    ]
  },
  "mixins": [
    "voicechat.mixins.json",
    {
      "config": "voicechat.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "coflmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=25",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "yet_another_config_lib_v3": "*"
  }
}
