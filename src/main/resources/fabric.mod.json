{
  "schemaVersion": 1,
  "id": "voicechat",
  "version": "${version}",
  "name": "Air Client",
  "description": "A Minecraft client with voice chat, Spotify, and a customizable liquid glass interface, plus Hypixel SkyBlock auction, bazaar and lowballing tools.",
  "authors": [
    "immadie111-oss",
    "PingPongPlus"
  ],
  "contact": {
    "homepage": "https://github.com/AeroAlpine/Air-Client",
    "sources": "https://github.com/AeroAlpine/Air-Client"
  },
  "license": "AGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "pingplus.voicechat.client.VoicechatDataGenerator"
    ],
    "client": [
      "pingplus.voicechat.client.VoicechatClient",
      "com.coflnet.CoflModClient"
    ],
    "main": [
      "pingplus.voicechat.Voicechat",
      "com.coflnet.CoflMod"
    ]
  },
  "mixins": [
    "voicechat.mixins.json",
    {
      "config": "voicechat.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "coflmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=25",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "yet_another_config_lib_v3": "*"
  }
}
